; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Морской бой(пока, что не онлайн)"
config/version="0.1"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=240
boot_splash/image="res://5323752473703344554.png"
config/icon="res://DALL·E 2024-10-20 01.19.57 - A minimalist pixel art avatar for a sea battle game, designed in a 50x50 pixel style. The image should have simple shapes and clean lines, with a focu.png"
config/windows_native_icon="res://DALL·E-2024-10-20-01.19.ico"
boot_splash/minimum_display_time=1000

[autoload]

Music="*res://music.gd"
NewScript="*res://new_script.gd"
Musicpanel="*res://musicpanel.gd"

[custom]

value_count1=0
value_count2=0
value_count3=0
value_count4=0
nujno_test=["А6", "Б6", "В6"]
first_kletka="А6"
sigma3=[]

[display]

window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://photo_2025-02-16_00-10-30.png"

[editor]

export/convert_text_resources_to_binary=false

